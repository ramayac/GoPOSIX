{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://goposix.dev/schemas/gunzip.schema.json",
  "title": "GoPOSIX gunzip --json output",
  "description": "Validates the complete JSON output of goposix gunzip --json.",
  "type": "object",
  "required": [
    "command",
    "version",
    "schemaVersion",
    "exitCode",
    "data",
    "error"
  ],
  "properties": {
    "command": {
      "type": "string",
      "const": "gunzip"
    },
    "version": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "exitCode": {
      "type": "integer"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "originalSize",
          "newSize",
          "ratio"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "originalSize": {
            "type": "integer"
          },
          "newSize": {
            "type": "integer"
          },
          "ratio": {
            "type": "number"
          },
          "content": {
            "type": "string",
            "description": "base64 payload in JSON stdout mode (F16)"
          }
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
