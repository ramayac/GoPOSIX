{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://goposix.dev/schemas/makedevs.schema.json",
  "title": "GoPOSIX makedevs --json output",
  "description": "Validates the complete JSON output of goposix makedevs --json.",
  "type": "object",
  "required": [
    "command",
    "version",
    "schemaVersion",
    "exitCode",
    "data",
    "error"
  ],
  "properties": {
    "command": {
      "type": "string",
      "const": "makedevs"
    },
    "version": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "exitCode": {
      "type": "integer"
    },
    "data": {
      "type": "object",
      "required": [
        "table",
        "rootdir",
        "created",
        "failedCount"
      ],
      "properties": {
        "table": {
          "type": "string"
        },
        "rootdir": {
          "type": "string"
        },
        "created": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "mode",
                  "uid",
                  "gid",
                  "status"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string"
                  },
                  "uid": {
                    "type": "integer"
                  },
                  "gid": {
                    "type": "integer"
                  },
                  "major": {
                    "type": "integer"
                  },
                  "minor": {
                    "type": "integer"
                  },
                  "status": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "failedCount": {
          "type": "integer"
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
