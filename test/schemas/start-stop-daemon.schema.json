{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://goposix.dev/schemas/start-stop-daemon.schema.json",
  "title": "GoPOSIX start-stop-daemon --json output",
  "description": "Validates the complete JSON output of goposix start-stop-daemon --json.",
  "type": "object",
  "required": [
    "command",
    "version",
    "schemaVersion",
    "exitCode",
    "data",
    "error"
  ],
  "properties": {
    "command": {
      "type": "string",
      "const": "start-stop-daemon"
    },
    "version": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "exitCode": {
      "type": "integer"
    },
    "data": {
      "type": "object",
      "required": [
        "action",
        "matchedPids",
        "status"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "matchedPids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "newPid": {
          "type": "integer"
        },
        "commandLine": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
