{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://goposix.dev/schemas/tree.schema.json",
  "title": "GoPOSIX tree --json output",
  "description": "Validates the complete JSON output of goposix tree --json.",
  "type": "object",
  "required": [
    "command",
    "version",
    "schemaVersion",
    "exitCode",
    "data",
    "error"
  ],
  "properties": {
    "command": {
      "type": "string",
      "const": "tree"
    },
    "version": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "exitCode": {
      "type": "integer"
    },
    "data": {
      "type": "object",
      "required": [
        "trees",
        "report"
      ],
      "properties": {
        "trees": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "report": {
          "type": "object",
          "required": [
            "directories",
            "files"
          ],
          "properties": {
            "directories": {
              "type": "integer"
            },
            "files": {
              "type": "integer"
            }
          }
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "error": {
          "type": "boolean"
        },
        "contents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    }
  }
}
