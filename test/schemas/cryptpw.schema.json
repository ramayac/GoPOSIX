{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://goposix.dev/schemas/cryptpw.schema.json",
  "title": "GoPOSIX cryptpw --json output",
  "description": "Validates the complete JSON output of goposix cryptpw --json.",
  "type": "object",
  "required": [
    "command",
    "version",
    "schemaVersion",
    "exitCode",
    "data",
    "error"
  ],
  "properties": {
    "command": {
      "type": "string",
      "const": "cryptpw"
    },
    "version": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "exitCode": {
      "type": "integer"
    },
    "data": {
      "type": "object",
      "required": [
        "password",
        "method",
        "salt",
        "hash"
      ],
      "properties": {
        "password": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "salt": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
